{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "gsb-holidays-website",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Pinned here so `wrangler deploy` can't silently strip this on a future
	// build — it was previously set only via the Cloudflare dashboard, and
	// with no committed wrangler.jsonc at all, every deploy auto-regenerated
	// a bare config (via `@opennextjs/cloudflare migrate`) with no routes.
	"routes": [
		{
			"pattern": "gsbholiday.com",
			"custom_domain": true
		}
	],
	// Runtime environment for the Worker. CRM_API_URL is the CRM's public,
	// unauthenticated read API base — not a secret (it's the same value in
	// .env.example). lib/cms.ts reads it at request time, and
	// normalizeCrmFileUrl re-bases CRM file URLs onto this origin.
	// The matching BUILD-time value lives in the Cloudflare dashboard under
	// Workers Builds -> Variables; next.config.ts needs it there to put the
	// CRM host into `images.remotePatterns`.
	// CRM_API_KEY is a secret and must stay out of this file — set it with
	// `wrangler secret put CRM_API_KEY`.
	"vars": {
		"CRM_API_URL": "https://admin.gsbholiday.com"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "gsb-holidays-website"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Backs the OpenNext incremental cache (see open-next.config.ts) so ISR
	// pages and `fetch(..., { next: { revalidate } })` calls to the CRM
	// actually get cached between requests instead of hitting it live on
	// every single page view.
	// Backs the OpenNext revalidation queue (see open-next.config.ts) — the
	// Durable Object is what actually executes background ISR regeneration.
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	],
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "2d3b1fcb7d62497599033db9fcd45115"
		}
	]
}
